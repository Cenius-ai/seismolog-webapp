# Seismolog reads every value with an in-code default, so none of these are
# required. They are listed for completeness; export them in your shell (the tool
# does not read .env files itself). Empty means "use the built-in default".
#
# Store path. Default: $HOME/.seismolog/events.jsonl (parent created on first write)
SEISMOLOG_STORE=

# Set to any non-empty value for plain, uncoloured output
NO_COLOR=
